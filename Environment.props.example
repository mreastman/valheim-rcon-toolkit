<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to Environment.props (same folder) and set the path below to
  your own Valheim dedicated server install directory -- the one containing
  Data/ and BepInEx/. Environment.props is gitignored since this path is
  machine-specific.
-->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <VALHEIM_DEDI_INSTALL>/path/to/Valheim dedicated server/valheim_server</VALHEIM_DEDI_INSTALL>
  </PropertyGroup>
</Project>
